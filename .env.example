# money-navi（toshi-navi.jp）の環境変数サンプル
# Vercel → Project → Settings → Environment Variables で設定。
# ローカル検証する場合は .env.local にコピーして値を入れる（.env.local は .gitignore 済）。

# ─────────────────────────────────────────
# GA4（Google Analytics 4）測定ID
# 取得手順は docs/ga4_runbook.md を参照。
# 未設定の場合、GA4 タグはページに埋め込まれず、affiliate_click 等のイベントは
# dataLayer に積まれるだけでGA4側には届かない（層に記録されない）。
# ─────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
